---
const step1 = `pnpm add @mcphero/core @mcphero/mcp zod`

const step2 = `import { createAction } from '@mcphero/core'
import z from 'zod'

export const GreetAction = createAction({
  name: 'greet',
  description: 'Greet a user by name',
  input: z.object({
    name: z.string().describe('Name to greet')
  }),
  run: async ({ name }) => {
    return { message: \`Hello, \${name}!\` }
  }
})`

const step3 = `import { mcphero } from '@mcphero/core'
import { stdio } from '@mcphero/mcp'
import { GreetAction } from './actions/greet.js'

await mcphero({ name: 'my-server', version: '1.0.0' })
  .adapter(stdio())
  .action(GreetAction)
  .start()`
---

<section id="quickstart" class="quickstart">
  <div class="container">
    <p class="section-label">Quick Start</p>
    <h2 class="section-title">Up and running in 3 steps.</h2>

    <div class="steps">
      <div class="step">
        <div class="step-number">1</div>
        <div class="step-content">
          <h3>Install</h3>
          <div class="code-block">
            <div class="code-block-header">
              <span>terminal</span>
              <button class="copy-btn" data-copy-raw={step1}>Copy</button>
            </div>
            <pre><code>{step1}</code></pre>
          </div>
        </div>
      </div>

      <div class="step">
        <div class="step-number">2</div>
        <div class="step-content">
          <h3>Define an action</h3>
          <div class="code-block">
            <div class="code-block-header">
              <span>actions/greet.ts</span>
              <button class="copy-btn" data-copy-raw={step2}>Copy</button>
            </div>
            <pre><code>{step2}</code></pre>
          </div>
        </div>
      </div>

      <div class="step">
        <div class="step-number">3</div>
        <div class="step-content">
          <h3>Pick an adapter and start</h3>
          <div class="code-block">
            <div class="code-block-header">
              <span>server.ts</span>
              <button class="copy-btn" data-copy-raw={step3}>Copy</button>
            </div>
            <pre><code>{step3}</code></pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .quickstart {
    border-top: 1px solid var(--border);
  }

  .steps {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin-top: 2.5rem;
  }

  .step {
    display: flex;
    gap: 1.5rem;
    align-items: flex-start;
  }

  .step-number {
    flex-shrink: 0;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--accent-bg);
    border: 1px solid rgba(99, 102, 241, 0.3);
    color: var(--accent);
    font-weight: 700;
    font-size: 0.9rem;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 0.25rem;
  }

  .step-content {
    flex: 1;
    min-width: 0;
  }

  .step-content h3 {
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
  }

  @media (max-width: 640px) {
    .step {
      flex-direction: column;
      gap: 0.75rem;
    }
  }
</style>

<script>
  document.querySelectorAll('.quickstart [data-copy-raw]').forEach(btn => {
    btn.addEventListener('click', async () => {
      const text = btn.getAttribute('data-copy-raw') || ''
      await navigator.clipboard.writeText(text)
      const original = btn.textContent
      btn.textContent = 'Copied!'
      setTimeout(() => { btn.textContent = original }, 1500)
    })
  })
</script>
