{
  "name": "mcphero",
  "version": "1.1.3",
  "description": "MCP Hero Toolkit",
  "type": "module",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "scripts": {
    "clean": "rimraf build",
    "build": "tsup",
    "prepack": "pnpm clean && pnpm build",
    "watch": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "check": "pnpm lint && pnpm typecheck",
    "cli": "tsx src/cli.ts",
    "mcp": "mcp-inspector --config .mcp.json --server astragraph"
  },
  "dependencies": {
    "@clack/core": "^1.1.0",
    "@clack/prompts": "^1.0.1",
    "@fastify/swagger": "^9.7.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@scalar/fastify-api-reference": "^1.49.0",
    "change-case": "^5.4.4",
    "cli-progress": "^3.12.0",
    "commander": "^13.1.0",
    "common-tags": "^1.8.2",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "fastify": "^5.8.2",
    "typescript": "^5.9.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/inspector": "^0.21.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/cli-progress": "^3.11.6",
    "@types/common-tags": "^1.8.4",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "rimraf": "^6.1.3",
    "tsup": "^8.0.0",
    "tsx": "^4.21.0",
    "typescript-eslint": "^8.56.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
